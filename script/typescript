import re[K
[K
path = "IDE/ui/view/ui.py"[K
with open(path, "r", encoding="utf-8") as f:[K
    src = f.read()[K
[K
# 1. Borrar toda la lógica del menú contextual de clic derecho[K
pattern = re.compile(r"        if event\.button\(\) == Qt\.MouseButton\.RightButton and not self\._space_pan:.*?event\.accept\(\)\n            return\n", re.DOTALL)[K
src = pattern.sub("", src)[K
[K
