new_resolve = '''def resolve_asset(project_folder, path):[K
    if not path:[K
        return None[K
    path = str(path)[K
    if os.path.isabs(path) and os.path.isfile(path):[K
        return path[K
[K
    # Buscar en la carpeta del proyecto[K
    base = project_folder or os.getcwd()[K
    full = os.path.join(base, path)[K
    if os.path.isfile(full):[K
        return full[K
