[90mdef reload_changed_scripts(scene, project_folder):[39m[K
[90m    """Recarga scripts cuyo archivo cambió en disco (hot-reload)."""[39m[K
[90m    reloaded = 0[39m[K
[90m    for obj in scene.objects:[39m[K
[90m        for comp in obj.get_components("Script"):[39m[K
[90m            path_rel = comp.get("path", "")[39m[K
[90m            if not path_rel:[39m[K
[90m                continue[39m[K
[90m            full = os.path.join(project_folder, path_rel)[39m[K
[90m            try:[39m[K
[90m                mtime = os.path.getmtime(full)[39m[K
[90m            except OSError:[39m[K
[90m                continue[39m[K
[90m            if mtime > getattr(comp, "_mtime", 0.0) + 1e-6:[39m[K
[90m                if comp.reload(project_folder):[39m[K
[90m                    reloaded += 1[39m[K
[90m    return reloaded[39m[K
