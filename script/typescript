    # 1. Buscar cualquier bloque que abra el menú con el botón derecho y borrarlo[K
    # Esto elimina desde "if event.button() == Qt.MouseButton.RightButton" hasta el "return" del bloque[K
    pattern = re.compile(r"        if event\.button\(\) == Qt\.MouseButton\.RightButton.*?return\n", re.DOTALL)[K
    src = pattern.sub("", src)[K
