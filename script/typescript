def reload_changed_scripts(scene, project_folder):[K
    """Recarga scripts cuyo archivo cambió en disco (hot-reload)."""[K
    reloaded = 0[K
    for obj in scene.objects:[K
        for comp in obj.get_components("Script"):[K
            path_rel = comp.get("path", "")[K
            if not path_rel:[K
                continue[K
            full = os.path.join(project_folder, path_rel)[K
            try:[K
                mtime = os.path.getmtime(full)[K
            except OSError:[K
                continue[K
            if mtime > getattr(comp, "_mtime", 0.0) + 1e-6:[K
                if comp.reload(project_folder):[K
                    reloaded += 1[K
