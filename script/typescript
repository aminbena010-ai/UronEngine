def _make_icon(color_hex, shape="square"):[K
    pm = QPixmap(14, 14)[K
    pm.fill(Qt.GlobalColor.transparent)[K
    p = QPainter(pm)[K
    p.setRenderHint(QPainter.RenderHint.Antialiasing)[K
    c = QColor(color_hex)[K
    p.setBrush(c)[K
    p.setPen(Qt.PenStyle.NoPen)[K
    if shape == "circle": p.drawEllipse(1, 1, 12, 12)[K
    elif shape == "diamond": p.drawPolygon(QPolygon([QPoint(7, 1), QPoint(13, 7), QPoint(7, 13), QPoint(1, 7)]))[K
    else: p.drawRect(2, 2, 10, 10)[K
    p.end()[K
    return QIcon(pm)[K
[K
_ICONS_CACHE = None[K
[K
def get_icons():[K
    global _ICONS_CACHE[K
    if _ICONS_CACHE is None:[K
        _ICONS_CACHE = {k: _make_icon(v, ICON_SHAPES.get(k, "square")) for k, v in ICON_COLORS.items()}[K
    return _ICONS_CACHE[K
